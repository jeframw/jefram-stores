# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database_name
# Or use individual variables:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=jefram_stores
# DB_USER=postgres
# DB_PASSWORD=your_secure_password

# Server Configuration
PORT=3000
NODE_ENV=production

# Security
JWT_SECRET=your_very_secure_random_secret_string_minimum_32_characters

# Google OAuth (for Google Sign-In)
# Create OAuth 2.0 credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id

# Apple Sign-In (for Apple Sign-In)
# Create at https://developer.apple.com/account/resources/authkeys/list
APPLE_SERVICE_ID=your_apple_service_id
APPLE_CLIENT_ID=com.jefram.stores
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key
# Or use APPLE_PRIVATE_KEY_FILE=/path/to/AuthKey_XXX.p8

# Twilio SMS (for phone OTP) - Optional, logs OTP to console if not configured
TWILIO_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890