# Database Configuration
# For local development (individual variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jefram_stores
DB_USER=postgres
DB_PASSWORD=your_password

# For Render deployment (use DATABASE_URL from Render PostgreSQL service)
DATABASE_URL=postgresql://user:password@host:port/database

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret (generate a secure random string for production)
JWT_SECRET=random_secret_string_for_security_789

# Firebase Service Account Configuration (for migration - optional)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=jefram-stores
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email
FIREBASE_CLIENT_ID=your_client_id
FIREBASE_AUTH_URI=https://oauth2.googleapis.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509