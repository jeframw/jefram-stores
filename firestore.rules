rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid));
    }

    function isOrderOwner(orderId, uid) {
      let orderPhone = get(/databases/$(database)/documents/orders/$(orderId)).data.customer.phone;
      let customerPhone = get(/databases/$(database)/documents/customers/$(uid)).data.phone;
      return orderPhone != null && customerPhone != null && orderPhone == customerPhone;
    }

    match /config/{document} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null && request.app != null && request.app.token.is_verified == true && isAdmin(request.auth.uid);
      allow update: if request.auth != null && request.app != null && request.app.token.is_verified == true && (
        isAdmin(request.auth.uid) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'sizes', 'discount_percent']) &&
         request.resource.data.stock is int &&
         request.resource.data.stock >= 0 &&
         request.resource.data.stock <= resource.data.stock &&
         request.resource.data.price is int &&
         request.resource.data.price >= 0)
      );
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create: if request.auth != null && isAdmin(request.auth.uid);
      allow update: if request.auth != null && (
        isAdmin(request.auth.uid) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
         request.resource.data.usedCount is int &&
         request.resource.data.usedCount >= resource.data.usedCount)
      );
      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow create: if request.auth != null && (request.auth.uid == adminId || isAdmin(request.auth.uid));
      allow update, delete: if false;
    }

    match /admin_users/{id} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /delivery_agents/{agentId} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /customers/{customerId} {
      allow read: if request.auth != null && (request.auth.uid == customerId || isAdmin(request.auth.uid));
      allow update: if request.auth != null && (request.auth.uid == customerId || isAdmin(request.auth.uid));
      allow create: if request.auth != null && request.auth.uid == customerId;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow get: if request.auth != null && (isOrderOwner(orderId, request.auth.uid) || isAdmin(request.auth.uid));
      allow list: if request.auth != null && request.query.limit <= 100;
      allow create: if request.auth != null &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.customerId is string &&
        request.resource.data.total is int &&
        request.resource.data.total >= 0 &&
        request.resource.data.status in ['pending', 'pending_payment', 'confirmed', 'on_way', 'delivered', 'cancelled'];
      allow update: if request.auth != null && (
        isAdmin(request.auth.uid) ||
        (isOrderOwner(orderId, request.auth.uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'product_rating', 'delivery_rating', 'rating_comment', 'rated_at'
         ])) ||
        (isOrderOwner(orderId, request.auth.uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status == 'cancelled')
      );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /password_resets/{resetId} {
      allow read, write: if false;
    }

    match /customer_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /admin_sessions/{sessionId} {
      allow read, write: if false;
    }
  }
}
